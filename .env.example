# 复制为 .env 并填入你自己的密钥；不要将 .env 上传 GitHub
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 按你的 DeepSeek 控制台支持的模型调整；最新官方文档可用 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
MAX_GRAPH_STEPS=85
MAX_PDF_MB=8
BROWSER_HEADLESS=false
# Windows 默认调用已安装的 Microsoft Edge；Linux 可设为 chromium
BROWSER_NAME=msedge
# 默认 public：允许经过固定公网 IP 出口检查的 HTTP/HTTPS；strict 才启用域名限制
NETWORK_MODE=public
# system 使用系统 DNS；可信本地 Fake-IP 网络可用 cloudflare（TLS 校验的固定公网 DoH）
PUBLIC_DNS_MODE=system
# strict 模式下限制顶层目标站点（逗号分隔）
ALLOWED_DOMAINS=
MAX_MODEL_CALLS=30
MAX_TOOL_CALLS=90
TASK_TIMEOUT_SECONDS=420
TOOL_TIMEOUT_SECONDS=40
# 可选但强烈建议：搜索 API，避免网页搜索被限流/验证码。
# 支持 brave / serper / tavily；没有 key 时自动回退到公开搜索页。
SEARCH_API_PROVIDER=
SEARCH_API_KEY=
# 不再支持 Fake-IP 私网地址例外；DNS 结果非公网时拒绝连接。
